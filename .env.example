# Copy this file to .env.local and replace the placeholder locally.
# Never commit a real API key.
GEMINI_API_KEY=your_gemini_api_key_here

# Public application URL used for local development examples.
APP_URL=http://localhost:3000

# Convex (browser-safe public URL; written by 'npx convex dev' into .env.local)
VITE_CONVEX_URL=https://your-deployment.convex.cloud
